# Copy to .env (repo root) and fill in before running `docker compose up -d --build`.

# Required: a HuggingFace access token with access granted to the NTv3
# checkpoint(s) you plan to use (NTv3 is gated; NTv2 is public). See services/ntv3/README.md "Getting access to the model
# weights". Create one at https://huggingface.co/settings/tokens
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Strongly recommended once this is reachable from outside localhost: any
# random shared secret. Clients must send `Authorization: Bearer <this value>`.
MCP_AUTH_TOKEN=change-me-to-a-long-random-string

# Optional: host directory for downloaded model weights (HuggingFace cache), shared
# by all services. Default ./models (repo root, git- and docker-ignored). Create it
# first (`mkdir -p <dir>`).
# MODELS_DIR=/data/dnalm-models

# Optional: free a model's GPU memory after this many seconds without requests
# (default 900; 0 = keep every loaded model resident).
# DNALM_IDLE_UNLOAD_SECONDS=900

# Optional: user/group the containers run as; must be able to write MODELS_DIR.
# Default 1000:1000. Set to the directory owner, e.g. the output of `id -u` / `id -g`.
# MODELS_UID=1000
# MODELS_GID=1000
