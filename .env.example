# Copy to .env and fill in before running `docker compose up`.

# Required: a HuggingFace access token with access granted to the NTv3
# checkpoint(s) you plan to use. See README.md "Getting access to the model
# weights". Create one at https://huggingface.co/settings/tokens
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Strongly recommended once this is reachable from outside localhost: any
# random shared secret. Clients must send `Authorization: Bearer <this value>`.
MCP_AUTH_TOKEN=change-me-to-a-long-random-string
