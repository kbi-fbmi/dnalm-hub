# syntax=docker/dockerfile:1
#
# CPU deployment image for ntv3-mcp. Builds a locked, reproducible environment
# with uv, then copies just the venv + source into a slim runtime image.
# Build from the REPO ROOT (needs packages/).
#
# On Linux, pyproject.toml's [tool.uv.sources] redirects the `torch` dependency
# to the CPU-only wheel index (see pyproject.toml), so this image does NOT pull
# the several-GB of CUDA runtime packages that a plain `pip install torch` would
# on Linux. For GPU inference, use the Dockerfile next to this one.
#
# Build:  docker build -f services/ntv3/Dockerfile.cpu -t ntv3-mcp:cpu .
# Run:    docker run --rm -p 8000:8000 -e HF_TOKEN=hf_xxx -e MCP_AUTH_TOKEN=change-me \
#           -v "$PWD/models":/models ntv3-mcp:cpu

FROM ghcr.io/astral-sh/uv:python3.11-bookworm-slim AS builder

WORKDIR /app/services/ntv3
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/app/.venv

# Install dependencies first so this (slow, large) layer is only rebuilt when
# pyproject.toml / uv.lock / the local packages/ actually change, not on
# every source edit. The local dnalm-common/dnalm-client path
# dependencies (see [tool.uv.sources] in pyproject.toml) must be present before
# the first `uv sync`, since uv builds them from source even for the
# dependency-only layer.
COPY services/ntv3/pyproject.toml services/ntv3/uv.lock ./
COPY packages /app/packages
RUN uv sync --frozen --no-install-project --no-dev

# Now install the project itself.
COPY services/ntv3/src ./src
COPY services/ntv3/README.md ./
RUN uv sync --frozen --no-dev


FROM python:3.11-slim-bookworm AS runtime

WORKDIR /app/services/ntv3

RUN useradd --create-home --uid 1000 --shell /usr/sbin/nologin appuser

COPY --from=builder /app/.venv /app/.venv
# Editable installs: the venv points at these source paths, so keep them identical.
COPY --from=builder /app/packages /app/packages
COPY --from=builder /app/services/ntv3 /app/services/ntv3

ENV PATH="/app/.venv/bin:${PATH}" \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/models \
    MCP_TRANSPORT=http \
    MCP_HOST=0.0.0.0 \
    MCP_PORT=8000 \
    MCP_PATH=/mcp \
    NTV3_DEVICE=cpu \
    NTV3_DTYPE=float32

RUN mkdir -p "$HF_HOME" && chown -R appuser:appuser /app /home/appuser "$HF_HOME"
USER appuser

EXPOSE 8000
VOLUME ["/models"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD ["python", "-c", "import os,urllib.request; urllib.request.urlopen('http://127.0.0.1:' + os.environ.get('MCP_PORT','8000') + '/health', timeout=3)"]

ENTRYPOINT ["ntv3-mcp"]
