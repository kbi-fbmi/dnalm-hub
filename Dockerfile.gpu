# syntax=docker/dockerfile:1
#
# GPU variant: NVIDIA CUDA runtime base + PyTorch's regular (CUDA-enabled) build,
# for running larger NTv3 checkpoints (650M) at usable speed.
#
# NOTE: this file was written for correctness against uv's documented behavior
# but could NOT be built or run in the sandbox this project was authored in (no
# Docker/GPU available there). Treat it as a best-effort starting point: run
# `docker build -f Dockerfile.gpu -t ntv3-mcp:gpu .` and a `--gpus all` smoke
# test yourself before relying on it, and adjust the CUDA tag below to match
# the driver on your host (check with `nvidia-smi`).
#
# Build:  docker build -f Dockerfile.gpu -t ntv3-mcp:gpu .
# Run:    docker run --rm --gpus all -p 8000:8000 -e HF_TOKEN=hf_xxx \
#           -e MCP_AUTH_TOKEN=change-me \
#           -v ntv3-hf-cache:/home/appuser/.cache/huggingface ntv3-mcp:gpu

FROM nvidia/cuda:12.5.1-runtime-ubuntu24.04

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.12 python3.12-venv python3-pip ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:${PATH}"

WORKDIR /app
ENV UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/app/.venv

COPY pyproject.toml uv.lock ./
# --no-sources-package torch: ignore this project's Linux -> CPU-wheel override
# (see pyproject.toml) so torch resolves from the default PyPI index instead,
# pulling its CUDA runtime dependencies. Not --frozen, since overriding the
# source requires re-resolving torch rather than installing exactly what the
# (CPU-pinned) lockfile recorded.
RUN uv sync --no-install-project --no-dev --no-sources-package torch

COPY src ./src
COPY main.py README.md LICENSE ./
RUN uv sync --no-dev --no-sources-package torch

RUN if getent passwd 1000 >/dev/null; then \
        existing_user="$(getent passwd 1000 | cut -d: -f1)"; \
        usermod --login appuser --home /home/appuser --move-home "$existing_user"; \
    else \
        useradd --create-home --uid 1000 --shell /usr/sbin/nologin appuser; \
    fi

ENV PATH="/app/.venv/bin:${PATH}" \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/home/appuser/.cache/huggingface \
    MCP_TRANSPORT=http \
    MCP_HOST=0.0.0.0 \
    MCP_PORT=8000 \
    MCP_PATH=/mcp \
    NTV3_DEVICE=cuda \
    NTV3_DTYPE=bfloat16

RUN mkdir -p "$HF_HOME" && chown -R appuser:$(id -g appuser) /home/appuser
USER appuser

EXPOSE 8000
VOLUME ["/home/appuser/.cache/huggingface"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD ["python3", "-c", "import os,urllib.request; urllib.request.urlopen('http://127.0.0.1:' + os.environ.get('MCP_PORT','8000') + '/health', timeout=3)"]

ENTRYPOINT ["ntv3-mcp"]
