# Build context is the repo root (images need packages/ + their own services/<name>/),
# so patterns are recursive.
.git
.gitignore
**/.venv
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache
**/dist
**/build
**/*.egg-info
**/tests
.env
.env.*
**/.DS_Store
.vscode
.idea
compose*.yaml
docs
examples
scripts
services/_template

# Model weights (MODELS_DIR default, see compose.yaml)
models
